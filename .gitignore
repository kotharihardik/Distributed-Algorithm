# ===========================================================
#  Secrets — never commit
# ===========================================================
.env
.env.bak
.env.example
.env.*.local
*.pem
id_rsa*
id_ed25519*

# ===========================================================
#  Build output — regenerated by "make"
# ===========================================================
*/bin/
*.o
*.out
a.out

# ===========================================================
#  Generated data — reproducible from the generator + seed,
#  so there is no reason to store ~100 MB of it
# ===========================================================
*/data/generated/

# ===========================================================
#  Scratch space used while the correctness check runs
# ===========================================================
*/results/.work/

# ===========================================================
#  SLURM job output — machine-specific, changes every run
# ===========================================================
*/results/slurm_*.log
*/results/slurm_*.err
slurm-*.out
job_*.log
job_*.err

# ===========================================================
#  Personal notes and helpers — useful to me, not part of
#  the submission
# ===========================================================
CLUSTER_NOTES.md
*/commands.txt

# The analysis scripts. Their OUTPUT is what gets submitted -
# results/report_tables.md and results/speedup.png are both
# committed - so the scripts that produced them are not needed
# in the handed-in tree.
*/scripts/summarize.py
*/scripts/plot_speedup.py

# ===========================================================
#  The question paper and the material that came with it —
#  handed to us, no need to hand it back
# ===========================================================
docs/

# ===========================================================
#  Packaging artifacts
# ===========================================================
*.zip
*.tar
*.tar.gz

# ===========================================================
#  Editor and OS clutter
# ===========================================================
.vscode/
.DS_Store
__pycache__/
*.pyc
